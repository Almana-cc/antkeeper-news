# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/antkeeper_news

# Trigger.dev Configuration
# Get your project ID from https://cloud.trigger.dev
TRIGGER_PROJECT_ID=your-project-id-here

# Manual Trigger API Protection
# Secret key for /api/trigger-fetch endpoint
CRON_SECRET=your-secret-key-here

# OpenRouter API for AI Categorization
# Sign up at https://openrouter.ai/ for free $10 credits (1000 req/day)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Admin authentication (nuxt-auth-utils)
# Session encryption password - must be at least 32 characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-32+-char-string
# GitHub OAuth App credentials - create one at https://github.com/settings/applications/new
# Callback URL: https://<your-domain>/auth/github (http://localhost:3000/auth/github in dev)
NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Comma-separated GitHub logins allowed to edit articles
NUXT_ADMIN_GITHUB_LOGINS=your-github-username
